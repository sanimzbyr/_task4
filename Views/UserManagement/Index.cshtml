
@model IEnumerable<User>
@{
    ViewBag.Title = "User Management";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>@ViewBag.Title</title>
  <link rel="stylesheet" href="~/css/auth-responsive.css" />
  <link rel="stylesheet" href="~/css/user-management.css" />
</head>
<body>
  <div class="container">
    <form id="__af" method="post" style="display:none">@Html.AntiForgeryToken()</form>
    <div class="brand"><span class="dot"></span><strong>User Management</strong></div>

    <div class="toolbar">
      <input id="search" class="input search" placeholder="Search users (name/email/role)"/>
      <button class="btn" id="btnBlock" title="Block selected">Block</button>
      <button class="btn secondary" id="btnUnblock" title="Unblock selected">Unblock</button>
      <button class="btn ghost" id="btnDelete" title="Delete selected">Delete</button>
      <span id="bulkMsg" class="help"></span>
    </div>

    <div class="table-wrap">
      
      <table id="userTable">
        <thead>
          <tr>
            <th style="width:44px"><input type="checkbox" id="checkAll" aria-label="Select all"/></th>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Registered</th>
            <th>Last Login</th>
          </tr>
        </thead>
        <tbody>
          @if (Model != null && Model.Any()) {
              foreach (var u in Model) {
                  <tr data-id="@u.Id">
                      <td><input type="checkbox" class="rowCheck" /></td>
                      <td>@u.Name</td>
                      <td>@u.Email</td>
                      <td>
                        @if (u.Status == UserStatus.Active) {
                          <span class="status active">Active</span>
                        } else if (u.Status == UserStatus.Blocked) {
                          <span class="status blocked">Blocked</span>
                        } else {
                          <span class="status">Deleted</span>
                        }
                      </td>
                      <td>@u.RegistrationTime.ToString("yyyy-MM-dd")</td>
                      <td>@u.LastLoginTime.ToString("yyyy-MM-dd")</td>
                  </tr>
              }
          } else {
              <tr><td colspan="6" class="help">No users found.</td></tr>
          }
        </tbody>
      </table>

    </div>
  </div>

  <script>
    // Select-all behavior
    const checkAll = document.getElementById('checkAll');
    checkAll?.addEventListener('change', ()=>{
      document.querySelectorAll('#userTable .rowCheck').forEach(cb=> cb.checked = checkAll.checked);
    });

    // Client-side filtering
    const search = document.getElementById('search');
    search?.addEventListener('input', ()=>{
      const q = search.value.toLowerCase();
      document.querySelectorAll('#userTable tbody tr').forEach(tr=>{
        tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
      });
    });

    async function bulk(action){
      const msg = document.getElementById('bulkMsg');
      msg.textContent='';
      const ids = Array.from(document.querySelectorAll('#userTable tbody tr'))
        .filter(tr => tr.querySelector('.rowCheck')?.checked)
        .map(tr => tr.getAttribute('data-id'));

      if(ids.length === 0){ msg.textContent='Select at least one row.'; return; }

      try{
        const res = await fetch('@Url.Action("BulkAction","UserManagement")', {
          method:'POST',
          headers:{
            'Content-Type':'application/json',
            'X-Requested-With':'XMLHttpRequest',
            'RequestVerificationToken': (document.querySelector("input[name='__RequestVerificationToken']")||{}).value || ''
          },
          body: JSON.stringify({ actionType: action, ids })
        });
        const json = await res.json();
        if(json.success){
          msg.className='success'; msg.textContent=json.message || 'Done';
          // Update UI statuses without a full reload
          ids.forEach(id => {
            const row = document.querySelector(`#userTable tbody tr[data-id="${id}"]`);
            if(!row) return;
            if(action === 'Delete') row.remove();
            if(action === 'Block'){
              const st = row.querySelector('.status');
              if(st){ st.classList.remove('active'); st.classList.add('blocked'); st.textContent='Blocked'; }
            }
            if(action === 'Unblock'){
              const st = row.querySelector('.status');
              if(st){ st.classList.remove('blocked'); st.classList.add('active'); st.textContent='Active'; }
            }
            row.querySelector('.rowCheck').checked = false;
          });
          checkAll.checked = false;
        }else{
          msg.className='err'; msg.textContent=json.message || 'Action failed.';
        }
      }catch(e){
        msg.className='err'; msg.textContent='Network error.';
      }
    }

    document.getElementById('btnBlock')?.addEventListener('click', ()=>bulk('Block'));
    document.getElementById('btnUnblock')?.addEventListener('click', ()=>bulk('Unblock'));
    document.getElementById('btnDelete')?.addEventListener('click', ()=>bulk('Delete'));
  </script>
</body>
</html>
